{
  "name": "off2zim-travel-platform",
  "version": "2.0.0",
  "description": "Modern travel platform for Zimbabwe tourism - converted to React/Next.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:main-web": "cross-env NEXT_PUBLIC_FORCE_SURFACE=public next dev -p 3000",
    "dev:provider-web": "cross-env NEXT_PUBLIC_FORCE_SURFACE=provider next dev -p 3002",
    "dev:admin-web": "cross-env NEXT_PUBLIC_FORCE_SURFACE=admin next dev -p 3003",
    "dev:backend": "node scripts/run-backend.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:taxonomy": "npx tsx prisma/seed-demo-taxonomy.ts",
    "db:seed:admin": "node scripts/seed-admin.js",
    "db:studio": "prisma studio",
    "db:dev:up": "docker compose -f docker-compose.postgres.yml up -d",
    "db:dev:down": "docker compose -f docker-compose.postgres.yml down",
    "db:dev:logs": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "db:bootstrap:postgres": "./scripts/bootstrap-postgres.sh",
    "db:reset:postgres": "./scripts/bootstrap-postgres.sh --reset",
    "db:baseline:generate": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/postgres-baseline.sql",
    "storage:bootstrap:supabase": "node scripts/bootstrap-supabase-storage.mjs",
    "production:check": "node scripts/check-production-readiness.mjs",
    "email:test": "node scripts/send-test-email.mjs",
    "vercel:build": "prisma generate && next build",
    "analyze": "cross-env ANALYZE=true next build",
    "netlify:build": "prisma generate && next build",
    "clean": "rimraf .next out dist build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.1.0",
    "@hookform/resolvers": "^3.3.0",
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@relume_io/relume-ui": "^1.3.1",
    "@tanstack/react-query": "^5.0.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.3.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.350.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.0",
    "next-themes": "^0.2.0",
    "paynow": "^2.2.2",
    "postcss": "^8.4.0",
    "prisma": "^5.10.0",
    "react": "^18.3.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-datepicker": "^6.0.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.50.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^5.0.0",
    "react-spring": "^10.0.1",
    "recharts": "^2.15.3",
    "resend": "^3.2.0",
    "sharp": "^0.33.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.0",
    "@playwright/test": "^1.42.0",
    "@storybook/nextjs": "^7.0.14",
    "@storybook/react": "^8.0.0",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-datepicker": "^6.0.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
