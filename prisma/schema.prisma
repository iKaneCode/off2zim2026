// Off2Zim Travel Platform Database Schema
// Zimbabwe Tourism Database with Booking, Payment, and User Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Authentication and User Management
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String    @id @default(cuid())
  firstName              String?
  lastName               String?
  name                   String?
  email                  String    @unique
  passwordHash           String?
  role                   String    @default("explorer")
  verificationStatus     String    @default("pending")
  hasVerifiedBadge       Boolean   @default(false)
  explorerType           String?
  emailVerified          DateTime?
  image                  String?
  phone                  String?
  nationality            String?
  preferences            String?   @default("{}")
  explorerScore          String?   @default("{}")
  guideApplicationStatus String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts                      Account[]
  sessions                      Session[]
  bookings                      Booking[]
  reviews                       Review[]
  payments                      Payment[]
  favorites                     Favorite[]
  uploadedStayGalleries         StayGallery[]                @relation("StayGalleryUploads")
  uploadedEventGalleries        EventGallery[]               @relation("EventGalleryUploads")
  ownedCompanies                ProviderCompany[]            @relation("CompanyOwner")
  verificationReviews           ProviderVerificationReview[] @relation("AdminVerificationReviews")
  openedDisputes                Dispute[]                    @relation("OpenedDisputes")
  disputeAssignments            Dispute[]                    @relation("AssignedDisputes")
  auditLogs                     AdminAuditLog[]              @relation("AdminAuditActor")
  shoppingCart                  ShoppingCart?
  shoppingOrders                ShoppingOrder[]              @relation("ShoppingOrderUser")
  guideApplication              GuideApplication?
  guideApplicationsReviewed     GuideApplication[]           @relation("GuideApplicationReviewer")
  guideProfile                  GuideProfile?
  guideBookings                 GuideBooking[]               @relation("ExplorerGuideBookings")
  forumQuestions                ForumQuestion[]
  forumAnswers                  ForumAnswer[]
  forumUpvotes                  ForumUpvote[]
  uploadedProviderMedia         ProviderMedia[]              @relation("ProviderMediaUploader")
  reviewedProviderMedia         ProviderMedia[]              @relation("ProviderMediaReviewer")
  createdNotificationCampaigns  NotificationCampaign[]       @relation("NotificationCampaignCreator")
  reviewedNotificationCampaigns NotificationCampaign[]       @relation("NotificationCampaignReviewer")
  createdExploreContent         ExploreContent[]             @relation("ExploreContentCreator")
  reviewedExploreContent        ExploreContent[]             @relation("ExploreContentReviewer")
  pushTokens                    PushToken[]
  notificationDeliveries        NotificationDelivery[]
  analyticsEvents               AnalyticsEvent[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tourism Content Models
model Destination {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  location     String
  imageUrl     String?
  images       String?  @default("[]")
  priceRange   String?
  rating       Float?   @default(0)
  weather      String?
  featured     Boolean  @default(false)
  category     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotels         Hotel[]
  activities     Activity[]
  restaurants    Restaurant[]
  events         Event[]
  forumQuestions ForumQuestion[]
  exploreContent ExploreContent[]

  @@index([featured, displayOrder])
  @@map("destinations")
}

model Hotel {
  id            String        @id @default(cuid())
  name          String
  description   String?
  address       String
  city          String
  destinationId String?
  category      String
  priceRange    String
  rating        Float?        @default(0)
  images        String?       @default("[]")
  amenities     String?       @default("[]")
  rooms         Room[]
  bookings      Booking[]
  reviews       Review[]
  gallery       StayGallery[]
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("hotels")
}

model Room {
  id          String  @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int
  price       Float
  currency    String  @default("USD")
  images      String? @default("[]")
  amenities   String? @default("[]")
  isAvailable Boolean @default(true)

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("rooms")
}

model Activity {
  id            String    @id @default(cuid())
  name          String
  description   String?
  destinationId String?
  category      String
  duration      String?
  difficulty    String?
  location      String
  price         Float
  currency      String    @default("USD")
  images        String?   @default("[]")
  includes      String?   @default("[]")
  excludes      String?   @default("[]")
  rating        Float?    @default(0)
  maxGuests     Int?
  bookings      Booking[]
  reviews       Review[]
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("activities")
}

model Restaurant {
  id            String    @id @default(cuid())
  name          String
  description   String?
  cuisine       String
  location      String
  destinationId String?
  priceRange    String
  rating        Float?    @default(0)
  images        String?   @default("[]")
  specialties   String?   @default("[]")
  amenities     String?   @default("[]")
  bookings      Booking[]
  reviews       Review[]
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("restaurants")
}

model Event {
  id            String         @id @default(cuid())
  name          String
  description   String?
  category      String
  location      String
  destinationId String?
  startDate     DateTime
  endDate       DateTime?
  price         Float
  currency      String         @default("USD")
  images        String?        @default("[]")
  capacity      Int?
  bookings      Booking[]
  reviews       Review[]
  tickets       EventTicket[]
  gallery       EventGallery[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@map("events")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType])
  @@map("favorites")
}

// Booking System
model Booking {
  id                 String    @id @default(cuid())
  userId             String
  providerId         String?
  listingId          String?
  bookingType        String    @default("HOTEL")
  status             String    @default("PENDING")
  totalAmount        Float
  currency           String    @default("USD")
  confirmationNumber String    @unique
  checkIn            DateTime?
  checkOut           DateTime?
  guests             Int?
  specialRequests    String?
  metadata           String?   @default("{}")
  providerRating     Int?
  providerRatingNote String?
  explorerRating     Int?
  explorerRatingNote String?
  isProviderRated    Boolean   @default(false)
  isExplorerRated    Boolean   @default(false)
  ratingsRevealedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relationships
  user           User             @relation(fields: [userId], references: [id])
  provider       ProviderCompany? @relation("ProviderBookings", fields: [providerId], references: [id])
  listing        ProviderListing? @relation(fields: [listingId], references: [id])
  payments       Payment[]
  disputes       Dispute[]
  calendarBlocks CalendarBlock[]

  // Tourism relationships (one-to-one with each type)
  hotel        Hotel?      @relation(fields: [hotelId], references: [id])
  hotelId      String?
  room         Room?       @relation(fields: [roomId], references: [id])
  roomId       String?
  activity     Activity?   @relation(fields: [activityId], references: [id])
  activityId   String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event        Event?      @relation(fields: [eventId], references: [id])
  eventId      String?

  @@map("bookings")
}

// Payment System
model Payment {
  id              String    @id @default(cuid())
  bookingId       String
  userId          String
  amount          Float
  currency        String    @default("USD")
  method          String    @default("CARD")
  status          String    @default("PENDING")
  stripePaymentId String?
  mobileProvider  String?
  phoneNumber     String?
  reference       String?
  metadata        String?   @default("{}")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("payments")
}

// Review System
model Review {
  id         String   @id @default(cuid())
  userId     String
  rating     Int
  comment    String?
  images     String?  @default("[]")
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  // Review can be for any tourism item
  hotel        Hotel?      @relation(fields: [hotelId], references: [id])
  hotelId      String?
  activity     Activity?   @relation(fields: [activityId], references: [id])
  activityId   String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?
  event        Event?      @relation(fields: [eventId], references: [id])
  eventId      String?

  @@map("reviews")
}

model ProviderCompany {
  id                         String    @id @default(cuid())
  ownerUserId                String
  companyName                String
  tradingName                String?
  businessRegistrationNumber String
  mainContactPerson          String
  businessPhone              String
  businessEmail              String
  physicalAddress            String
  headquartersCity           String?
  businessCategory           String?
  businessDescription        String?
  establishedYear            Int?
  numberOfEmployees          String?
  operatingHours             String?
  websiteUrl                 String?
  socialMediaLinks           String?   @default("{}")
  servicesOffered            String?   @default("[]")
  serviceAreas               String?   @default("[]")
  onboardingStatus           String    @default("draft")
  verificationTier           String    @default("basic")
  providerTier               String    @default("basic")
  tierStatus                 String    @default("active")
  isVerified                 Boolean   @default(false)
  isFeaturedEligible         Boolean   @default(false)
  reviewSubmittedAt          DateTime?
  basicApprovedAt            DateTime?
  verifiedBadgeExpiresAt     DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  owner                 User                         @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  documents             ProviderDocument[]
  listings              ProviderListing[]
  bookings              Booking[]                    @relation("ProviderBookings")
  verificationReviews   ProviderVerificationReview[]
  disputes              Dispute[]
  auditLogs             AdminAuditLog[]
  subscriptions         Subscription[]
  payouts               Payout[]
  plans                 ProviderPlan[]
  media                 ProviderMedia[]
  locations             ProviderLocation[]
  calendarBlocks        CalendarBlock[]
  notificationCampaigns NotificationCampaign[]

  @@unique([ownerUserId])
  @@index([onboardingStatus])
  @@index([verificationTier])
  @@index([providerTier, tierStatus])
}

model ProviderDocument {
  id         String    @id @default(cuid())
  companyId  String
  type       String
  fileName   String
  fileUrl    String?
  status     String    @default("pending")
  notes      String?
  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model ProviderVerificationReview {
  id              String    @id @default(cuid())
  companyId       String
  reviewedById    String?
  reviewType      String    @default("basic_review")
  status          String    @default("pending")
  notes           String?
  internalSummary String?
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  company    ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("AdminVerificationReviews", fields: [reviewedById], references: [id])

  @@index([companyId, status])
}

model ProviderListing {
  id                  String   @id @default(cuid())
  companyId           String
  title               String
  slug                String   @unique
  category            String
  listingType         String
  shortDescription    String?
  description         String
  location            String
  pricingModel        String   @default("per_service")
  basePrice           Float?
  currency            String   @default("USD")
  instantBooking      Boolean  @default(false)
  bookingMode         String   @default("request")
  status              String   @default("draft")
  visibility          String   @default("private")
  capacity            Int?
  pickupLeadTimeHours Int?
  images              String?  @default("[]")
  tags                String?  @default("[]")
  amenities           String?  @default("[]")
  policies            String?  @default("{}")
  metadata            String?  @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company         ProviderCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  availability    ListingAvailability[]
  bookings        Booking[]
  shoppingProduct ShoppingProduct?
  featuredEntries FeaturedEntry[]
  media           ProviderMedia[]
  locations       ProviderLocation[]
  fees            ProviderFee[]
  calendarBlocks  CalendarBlock[]

  @@index([companyId, status])
  @@index([category, visibility, status])
}

model ListingAvailability {
  id             String   @id @default(cuid())
  listingId      String
  startDate      DateTime
  endDate        DateTime
  unitsAvailable Int?
  status         String   @default("available")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listing ProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate, endDate])
}

model ProviderPlan {
  id           String    @id @default(cuid())
  companyId    String
  tier         String    @default("basic")
  status       String    @default("active")
  billingCycle String?
  externalRef  String?
  features     String    @default("{}")
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([tier, status])
  @@map("provider_plans")
}

model ProviderMedia {
  id              String    @id @default(cuid())
  companyId       String
  listingId       String?
  uploadedById    String?
  reviewedById    String?
  mediaType       String
  title           String?
  caption         String?
  altText         String?
  url             String
  thumbnailUrl    String?
  mimeType        String?
  sizeBytes       Int?
  sortOrder       Int       @default(0)
  visibility      String    @default("private")
  status          String    @default("pending_review")
  rejectionReason String?
  metadata        String    @default("{}")
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    ProviderCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listing    ProviderListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation("ProviderMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy User?            @relation("ProviderMediaReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, mediaType])
  @@index([listingId, status, sortOrder])
  @@index([uploadedById])
  @@index([reviewedById])
  @@map("provider_media")
}

model ProviderLocation {
  id              String   @id @default(cuid())
  companyId       String
  listingId       String?
  label           String?
  address         String?
  city            String?
  province        String?
  country         String   @default("ZW")
  latitude        Float?
  longitude       Float?
  serviceRadiusKm Float?
  mapVisibility   String   @default("hidden")
  status          String   @default("pending_review")
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company ProviderCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listing ProviderListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([listingId, status])
  @@index([mapVisibility, status])
  @@map("provider_locations")
}

model ProviderFee {
  id          String   @id @default(cuid())
  listingId   String
  name        String
  description String?
  price       Float
  currency    String   @default("USD")
  unit        String   @default("fixed")
  minGuests   Int?
  maxGuests   Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing ProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, isActive, sortOrder])
  @@map("provider_fees")
}

model CalendarBlock {
  id          String   @id @default(cuid())
  companyId   String
  listingId   String
  bookingId   String?
  startDate   DateTime
  endDate     DateTime
  reason      String   @default("unavailable")
  source      String   @default("provider_manual")
  status      String   @default("active")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listing ProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([companyId, startDate, endDate])
  @@index([listingId, startDate, endDate])
  @@index([bookingId])
  @@index([status, startDate])
  @@map("calendar_blocks")
}

model StayGallery {
  id           String   @id @default(cuid())
  hotelId      String   @map("stay_id")
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  caption      String?
  altText      String?  @map("alt_text")
  category     String?
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  hotel      Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("StayGalleryUploads", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([hotelId, sortOrder])
  @@map("stay_gallery")
}

model EventTicket {
  id               String    @id @default(cuid())
  eventId          String
  ticketType       String
  name             String
  description      String?
  basePrice        Float
  currency         String    @default("USD")
  originalPrice    Float?
  totalTickets     Int?
  ticketsSold      Int       @default(0)
  ticketsAvailable Int?
  minPurchase      Int       @default(1)
  maxPurchase      Int       @default(10)
  perks            String?   @default("[]")
  saleStartDate    DateTime?
  saleEndDate      DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, isActive])
  @@map("event_tickets")
}

model EventGallery {
  id           String   @id @default(cuid())
  eventId      String
  imageUrl     String   @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  caption      String?
  altText      String?  @map("alt_text")
  category     String?
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("EventGalleryUploads", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([eventId, sortOrder])
  @@map("event_gallery")
}

model Dispute {
  id              String    @id @default(cuid())
  bookingId       String
  companyId       String?
  openedByUserId  String
  assignedAdminId String?
  reason          String
  details         String?
  status          String    @default("open")
  resolution      String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  booking       Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company       ProviderCompany? @relation(fields: [companyId], references: [id])
  openedBy      User             @relation("OpenedDisputes", fields: [openedByUserId], references: [id])
  assignedAdmin User?            @relation("AssignedDisputes", fields: [assignedAdminId], references: [id])

  @@index([status, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  companyId   String?
  action      String
  targetType  String
  targetId    String
  summary     String
  metadata    String?  @default("{}")
  createdAt   DateTime @default(now())

  admin   User             @relation("AdminAuditActor", fields: [adminUserId], references: [id])
  company ProviderCompany? @relation(fields: [companyId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

// ─── Community Guide System ──────────────────────────────────────────────────

model GuideApplication {
  id           String    @id @default(cuid())
  userId       String    @unique
  bio          String
  expertise    String    @default("[]") // JSON string[]
  destinations String    @default("[]") // JSON string[]
  status       String    @default("pending") // pending | approved | rejected | more_info
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applicant  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("GuideApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("guide_applications")
}

model GuideProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String
  specialties  String   @default("[]") // JSON string[]
  languages    String   @default("[]") // JSON string[]
  destinations String   @default("[]") // JSON string[]
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services GuideService[]

  @@map("guide_profiles")
}

model GuideService {
  id          String   @id @default(cuid())
  guideId     String
  title       String
  description String
  serviceType String // planning | video_call | in_person_tour
  price       Float
  currency    String   @default("USD")
  durationMin Int // duration in minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guide    GuideProfile   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  bookings GuideBooking[]

  @@index([guideId, isActive])
  @@map("guide_services")
}

model GuideBooking {
  id               String   @id @default(cuid())
  serviceId        String
  explorerId       String
  scheduledAt      DateTime
  status           String   @default("pending") // pending | confirmed | completed | cancelled
  totalAmount      Float
  commissionAmount Float
  netAmount        Float
  currency         String   @default("USD")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  service  GuideService @relation(fields: [serviceId], references: [id])
  explorer User         @relation("ExplorerGuideBookings", fields: [explorerId], references: [id])

  @@index([explorerId, createdAt])
  @@index([serviceId, status])
  @@map("guide_bookings")
}

// ─── Ask a Local Forum ───────────────────────────────────────────────────────

model ForumQuestion {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  body          String
  tags          String   @default("[]") // JSON string[]
  destinationId String?
  viewCount     Int      @default(0)
  isPinned      Boolean  @default(false)
  isRemoved     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  destination Destination?  @relation(fields: [destinationId], references: [id])
  answers     ForumAnswer[]

  @@index([createdAt])
  @@index([destinationId])
  @@map("forum_questions")
}

model ForumAnswer {
  id            String   @id @default(cuid())
  questionId    String
  authorId      String
  body          String
  isGuideAnswer Boolean  @default(false)
  upvoteCount   Int      @default(0)
  isRemoved     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  question ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  upvotes  ForumUpvote[]

  @@index([questionId, createdAt])
  @@map("forum_answers")
}

model ForumUpvote {
  id       String @id @default(cuid())
  answerId String
  userId   String

  answer ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@map("forum_upvotes")
}

// ─── Shopping Marketplace ────────────────────────────────────────────────────

model ShoppingProduct {
  id                   String   @id @default(cuid())
  listingId            String   @unique
  stockQuantity        Int      @default(0)
  pickupLeadTimeHours  Int      @default(24)
  operatingHours       String   @default("{}") // JSON {mon: "09:00-17:00", ...}
  offersShipping       Boolean  @default(false)
  shippingFee          Float?
  deliveryEstimateDays Int?
  variants             String   @default("[]") // JSON [{name,options:[]}]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  listing    ProviderListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems ShoppingOrderItem[]

  @@map("shopping_products")
}

model ShoppingCart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("shopping_carts")
}

model CartItem {
  id              String    @id @default(cuid())
  cartId          String
  productId       String
  quantity        Int       @default(1)
  deliveryMethod  String    @default("pickup") // pickup | shipping
  pickupDate      DateTime?
  shippingAddress String? // JSON
  variantKey      String? // e.g. "Color:Red,Size:M"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cart    ShoppingCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product ShoppingProduct @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantKey])
  @@map("cart_items")
}

model ShoppingOrder {
  id            String   @id @default(cuid())
  userId        String
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  totalAmount   Float
  shippingTotal Float    @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User                @relation("ShoppingOrderUser", fields: [userId], references: [id])
  items ShoppingOrderItem[]

  @@index([userId, createdAt])
  @@map("shopping_orders")
}

model ShoppingOrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  productId           String
  vendorCompanyId     String
  quantity            Int
  unitPrice           Float
  variantKey          String?
  deliveryMethod      String // pickup | shipping
  pickupDate          DateTime?
  shippingAddress     String? // JSON
  shippingFee         Float     @default(0)
  status              String    @default("pending") // pending | confirmed | shipped | completed | cancelled
  pickupPin           String?
  pinVerifiedAt       DateTime?
  shippingConfirmedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order   ShoppingOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShoppingProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([vendorCompanyId, status])
  @@map("shopping_order_items")
}

// ─── Monetization Engine ─────────────────────────────────────────────────────

model Subscription {
  id                 String    @id @default(cuid())
  companyId          String
  planType           String // verified_badge | featured_placement
  billingCycle       String // monthly | annual
  status             String    @default("active") // active | cancelled | expired | past_due
  // Payment reference — populated when integrated with Stripe or Paynow
  externalRef        String? // Stripe subscription ID or Paynow poll URL
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, planType, status])
  @@map("subscriptions")
}

model PlatformCommission {
  id               String   @id @default(cuid())
  // transactionType: booking | guide_booking | shop_order
  transactionType  String
  transactionId    String // bookingId, guideBookingId, or shoppingOrderId
  grossAmount      Float
  commissionRate   Float // e.g. 0.25 for 25%
  commissionAmount Float
  netAmount        Float // grossAmount - commissionAmount
  currency         String   @default("USD")
  status           String   @default("held") // held | released | refunded
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([transactionType, transactionId])
  @@index([status, createdAt])
  @@map("platform_commissions")
}

model Payout {
  id          String    @id @default(cuid())
  companyId   String
  amount      Float
  currency    String    @default("USD")
  method      String // bank_transfer | ecocash | onemoney | telecash
  accountRef  String // phone number or bank account reference
  status      String    @default("pending") // pending | processing | completed | failed
  reference   String? // external payment reference
  notes       String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company ProviderCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status, requestedAt])
  @@map("payouts")
}

model FeaturedEntry {
  id            String   @id @default(cuid())
  listingId     String
  pathway       String // sponsored | top_rated | editors_choice
  justification String? // required for editors_choice
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing ProviderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([pathway, isActive, startDate])
  @@map("featured_entries")
}

model NotificationCampaign {
  id              String    @id @default(cuid())
  companyId       String
  createdById     String
  reviewedById    String?
  title           String
  body            String
  imageUrl        String?
  campaignType    String    @default("announcement")
  discountValue   Float?
  targetAudience  String    @default("{}")
  status          String    @default("draft")
  scheduledAt     DateTime?
  sentAt          DateTime?
  reviewNotes     String?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    ProviderCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User                   @relation("NotificationCampaignCreator", fields: [createdById], references: [id])
  reviewedBy User?                  @relation("NotificationCampaignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([companyId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([createdById])
  @@map("notification_campaigns")
}

model PushToken {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique
  platform      String
  appVariant    String   @default("tourist")
  deviceCountry String?
  city          String?
  locale        String?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, appVariant])
  @@index([platform, lastSeenAt])
  @@index([deviceCountry, lastSeenAt])
  @@map("push_tokens")
}

model NotificationDelivery {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  pushTokenId String?
  status      String    @default("pending")
  error       String?
  sentAt      DateTime?
  openedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign  NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken PushToken?           @relation(fields: [pushTokenId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([userId, status])
  @@index([pushTokenId])
  @@map("notification_deliveries")
}

model ExploreContent {
  id            String    @id @default(cuid())
  type          String
  title         String
  description   String?
  imageUrl      String?
  destinationId String?
  latitude      Float?
  longitude     Float?
  category      String?
  filterKey     String?
  filterValue   String?
  status        String    @default("draft")
  visibility    String    @default("private")
  sortOrder     Int       @default(0)
  metadata      String    @default("{}")
  createdById   String
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("ExploreContentCreator", fields: [createdById], references: [id])
  reviewedBy  User?        @relation("ExploreContentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([type, status, sortOrder])
  @@index([destinationId, status])
  @@index([category, status])
  @@map("explore_content")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventType  String
  appSurface String
  country    String?
  city       String?
  region     String?
  device     String?
  platform   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([appSurface, createdAt])
  @@index([country, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
